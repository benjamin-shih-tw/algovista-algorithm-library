{
  "name": "algovista-algorithm-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "audit:catalog": "esbuild scripts/auditCatalog.ts --bundle --platform=node --format=esm --outfile=/tmp/algovista-catalog-audit.mjs && node /tmp/algovista-catalog-audit.mjs",
    "audit:templates": "esbuild scripts/reportTemplates.ts --bundle --platform=node --format=esm --outfile=/tmp/algovista-template-audit.mjs && node /tmp/algovista-template-audit.mjs",
    "audit:knowledge": "esbuild scripts/auditKnowledge.ts --bundle --platform=node --format=esm --outfile=/tmp/algovista-knowledge-audit.mjs && node /tmp/algovista-knowledge-audit.mjs",
    "audit:cpp": "esbuild scripts/auditCpp.ts --bundle --platform=node --format=esm --outfile=/tmp/algovista-cpp-audit.mjs && node /tmp/algovista-cpp-audit.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
